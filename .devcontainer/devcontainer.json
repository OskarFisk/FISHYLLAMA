{
  "name": "FishyLLAMA Dev",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.12-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/node:1": {"version": "22"}
  },
  "forwardPorts": [8000],
  "portsAttributes": {
    "8000": {"label": "FishyLLAMA", "onAutoForward": "openBrowser"}
  },
  "postCreateCommand": "python -m pip install --upgrade pip && pip install -r requirements.txt",
  "customizations": {
    "vscode": {
      "extensions": ["ms-python.python", "ms-python.vscode-pylance", "ms-azuretools.vscode-docker", "GitHub.copilot", "GitHub.copilot-chat"]
    }
  }
}
